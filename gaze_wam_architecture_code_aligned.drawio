<mxfile host="app.diagrams.net" modified="2026-08-07T00:00:00.000Z" agent="Codex via official draw.io MCP" version="24.7.17" type="device" compressed="false">
  <diagram id="gaze-wam-data" name="01 数据与损失路由">
    <mxGraphModel dx="1900" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="d_title" value="Gaze-WAM 数据契约与精确损失路由" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=28;fontStyle=1;fontColor=#111827;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1280" height="42" as="geometry"/></mxCell>
        <mxCell id="d_subtitle" value="代码基线 gaze-wam-cleanup（2026-08-07） | train_gaze_wam_workspace.yaml + task/gaze_wam.yaml | data_mixing 解析总 batch 与 source ratio；主配置当前为 48 robot + 16 open = 64" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#4B5563;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="42" y="68" width="1460" height="28" as="geometry"/></mxCell>
        <mxCell id="d_badge" value="DATA + ROUTING" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#FFFFFF;fillColor=#374151;strokeColor=#374151;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1640" y="34" width="200" height="36" as="geometry"/></mxCell>
        <mxCell id="d_robot_src" value="&lt;b&gt;Robot Zarr&lt;/b&gt;&lt;br&gt;camera0_rgb&lt;br&gt;gaze_xy&lt;br&gt;action_abs_tcp&lt;br&gt;tcp_pose_abs + gripper_width" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=10;fillColor=#E8F1FB;strokeColor=#2F6FAE;fontColor=#163B5C;" vertex="1" parent="1"><mxGeometry x="40" y="145" width="230" height="150" as="geometry"/></mxCell>
        <mxCell id="d_robot_ds" value="&lt;b&gt;GazeWamRobotDataset&lt;/b&gt;&lt;br&gt;RGB [2,3,256,256], gaze [2]&lt;br&gt;future abs TCP + gripper -&gt; [16,10]&lt;br&gt;base = current TCP + gripper [10]&lt;br&gt;base^-1 @ future -&gt; relative action&lt;br&gt;gripper 始终保留绝对标量" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=10;fillColor=#E8F1FB;strokeColor=#2F6FAE;fontColor=#163B5C;" vertex="1" parent="1"><mxGeometry x="320" y="130" width="315" height="180" as="geometry"/></mxCell>
        <mxCell id="d_robot_batch" value="&lt;b&gt;Robot quota (main default = 48)&lt;/b&gt;&lt;br&gt;action [B_robot,16,10]&lt;br&gt;is_open=False, has_action=True&lt;br&gt;B_robot is resolved from total_batch_size_per_process * robot_ratio&lt;br&gt;dropout ~ Bernoulli(0.2); use_gaze=(~dropout) &amp; has_gaze_label&lt;br&gt;has_heatmap=~use_gaze when configured" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=10;fillColor=#E9F7EF;strokeColor=#2D8A58;fontColor=#195D38;" vertex="1" parent="1"><mxGeometry x="690" y="130" width="315" height="180" as="geometry"/></mxCell>
        <mxCell id="d_open_src" value="&lt;b&gt;Open Zarr&lt;/b&gt;&lt;br&gt;camera0_rgb&lt;br&gt;gaze_xy&lt;br&gt;无 robot action 标签" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=10;fillColor=#F2ECFA;strokeColor=#7B4AB0;fontColor=#4C2675;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="230" height="125" as="geometry"/></mxCell>
        <mxCell id="d_open_ds" value="&lt;b&gt;GazeWamOpenDataset&lt;/b&gt;&lt;br&gt;RGB [2,3,256,256], gaze [2]&lt;br&gt;action 为 [16,10] 零占位&lt;br&gt;heatmap 字段也是占位；dsnt_js 目标在线生成" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=10;fillColor=#F2ECFA;strokeColor=#7B4AB0;fontColor=#4C2675;" vertex="1" parent="1"><mxGeometry x="320" y="370" width="315" height="165" as="geometry"/></mxCell>
        <mxCell id="d_open_batch" value="&lt;b&gt;Open quota (main default = 16)&lt;/b&gt;&lt;br&gt;is_open=True, has_action=False&lt;br&gt;has_heatmap=True&lt;br&gt;use_gaze_condition=False; learned [MASK]&lt;br&gt;B_open is resolved from total_batch_size_per_process * open_ratio&lt;br&gt;heatmap loss still requires has_gaze_label=True" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=10;fillColor=#F2ECFA;strokeColor=#7B4AB0;fontColor=#4C2675;" vertex="1" parent="1"><mxGeometry x="690" y="370" width="315" height="165" as="geometry"/></mxCell>
        <mxCell id="d_mix" value="&lt;b&gt;build_gaze_wam_mixed_batch&lt;/b&gt;&lt;br&gt;逐字段 concat robot + open&lt;br&gt;action/open action metadata zero placeholders&lt;br&gt;online randperm -&gt; B_total = B_robot + B_open&lt;br&gt;quotas are fixed per optimizer microbatch, not fixed globally at 75/25&lt;br&gt;&lt;br&gt;BoolTensor [B_total]: is_open, has_action, has_heatmap,&lt;br&gt;has_gaze_label, use_gaze_condition, is_gaze_condition_dropped" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=12;fillColor=#F4F5F7;strokeColor=#374151;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="1060" y="205" width="325" height="255" as="geometry"/></mxCell>
        <mxCell id="d_route_title" value="逐行损失路由（dsnt_js）" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontStyle=1;fontColor=#374151;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1510" y="112" width="330" height="30" as="geometry"/></mxCell>
        <mxCell id="d_route_real" value="&lt;b&gt;Robot + real gaze&lt;/b&gt;&lt;br&gt;use_gaze=True, has_heatmap=False&lt;br&gt;Action loss: YES&lt;br&gt;Heatmap loss: NO" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=10;fillColor=#E9F7EF;strokeColor=#2D8A58;fontColor=#195D38;" vertex="1" parent="1"><mxGeometry x="1510" y="155" width="330" height="115" as="geometry"/></mxCell>
        <mxCell id="d_route_drop" value="&lt;b&gt;Robot + gaze label + dropout&lt;/b&gt;&lt;br&gt;use_gaze=False -&gt; learned [MASK]&lt;br&gt;has_heatmap=True&lt;br&gt;Action loss: YES | Heatmap loss: YES" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=10;fillColor=#FFF4D6;strokeColor=#C58A14;fontColor=#6B4A0B;" vertex="1" parent="1"><mxGeometry x="1510" y="295" width="330" height="125" as="geometry"/></mxCell>
        <mxCell id="d_route_missing" value="&lt;b&gt;Robot + missing gaze label&lt;/b&gt;&lt;br&gt;use_gaze=False -&gt; learned [MASK]&lt;br&gt;has_heatmap=True，但 target mask=False&lt;br&gt;Action loss: YES | Heatmap loss: NO" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=10;fillColor=#FDECEC;strokeColor=#B94A48;fontColor=#7A2523;" vertex="1" parent="1"><mxGeometry x="1510" y="445" width="330" height="125" as="geometry"/></mxCell>
        <mxCell id="d_route_open" value="&lt;b&gt;Open + gaze label&lt;/b&gt;&lt;br&gt;learned [MASK], has_heatmap=True&lt;br&gt;Action loss: NO | Heatmap loss: YES&lt;br&gt;若 label 缺失则 heatmap loss 也为 NO" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=10;fillColor=#F2ECFA;strokeColor=#7B4AB0;fontColor=#4C2675;" vertex="1" parent="1"><mxGeometry x="1510" y="595" width="330" height="125" as="geometry"/></mxCell>
        <mxCell id="d_masks" value="&lt;b&gt;Policy 中的精确 mask&lt;/b&gt;&lt;br&gt;action_loss_mask = (~is_open) &amp; has_action&lt;br&gt;target_gaze_mask = has_heatmap &amp; has_gaze_label&lt;br&gt;dsnt_js: heatmap_loss_mask = target_gaze_mask&lt;br&gt;&lt;br&gt;没有动态 head freezing；两个 head 均保持可训练。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;fontFamily=Arial;fontSize=14;align=left;verticalAlign=middle;spacing=12;fillColor=#FFFFFF;strokeColor=#374151;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="690" y="650" width="695" height="175" as="geometry"/></mxCell>
        <mxCell id="d_action_contract" value="&lt;b&gt;10D action 语义&lt;/b&gt;&lt;br&gt;3 translation + 6 rotation (6D) + 1 absolute gripper&lt;br&gt;TCP 相对变换：base^-1 @ future；推理恢复：base @ relative" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=10;fillColor=#FFF1E8;strokeColor=#D76824;fontColor=#7A3514;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="595" height="135" as="geometry"/></mxCell>
        <mxCell id="d_note" value="关键代码：gaze_wam_dataset.py::__getitem__ | action_utils.py::{absolute_actions_to_relative_actions, relative_actions_to_absolute_actions} | gaze_wam_mixing.py::build_gaze_wam_mixed_batch | gaze_wam_policy.py::{_validate_loss_batch_contract, loss_routing_contract_summary}" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=11;fontColor=#4B5563;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="1015" width="1780" height="45" as="geometry"/></mxCell>
        <mxCell id="d_e1" edge="1" source="d_robot_src" target="d_robot_ds" parent="1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeColor=#2F6FAE;strokeWidth=2;endArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d_e2" edge="1" source="d_robot_ds" target="d_robot_batch" parent="1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeColor=#2F6FAE;strokeWidth=2;endArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d_e3" edge="1" source="d_open_src" target="d_open_ds" parent="1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeColor=#7B4AB0;strokeWidth=2;endArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d_e4" edge="1" source="d_open_ds" target="d_open_batch" parent="1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeColor=#7B4AB0;strokeWidth=2;endArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d_e5" edge="1" source="d_robot_batch" target="d_mix" parent="1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeColor=#2D8A58;strokeWidth=2;endArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.25;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1020" y="220"/><mxPoint x="1020" y="268.75"/></Array></mxGeometry></mxCell>
        <mxCell id="d_e6" edge="1" source="d_open_batch" target="d_mix" parent="1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeColor=#7B4AB0;strokeWidth=2;endArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.75;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1045" y="452.5"/><mxPoint x="1045" y="396.25"/></Array></mxGeometry></mxCell>
        <mxCell id="d_e7" value="row masks" edge="1" source="d_mix" target="d_route_real" parent="1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeColor=#4B5563;strokeWidth=1.5;endArrow=classic;fontSize=11;exitX=1;exitY=0.12;entryX=0;entryY=0.5;labelPosition=right;verticalLabelPosition=middle;align=left;spacingLeft=8;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1405" y="235.6"/><mxPoint x="1405" y="212.5"/></Array></mxGeometry></mxCell>
        <mxCell id="d_e8" edge="1" source="d_mix" target="d_route_drop" parent="1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeColor=#4B5563;strokeWidth=1.5;endArrow=classic;exitX=1;exitY=0.38;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1435" y="301.9"/><mxPoint x="1435" y="357.5"/></Array></mxGeometry></mxCell>
