  </diagram>
  <diagram id="gaze-wam-model" name="02 Cached Dual-Stream 模型">
    <mxGraphModel dx="1900" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="m_title" value="Gaze-WAM Cached Dual-Stream：实现级模型结构" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=28;fontStyle=1;fontColor=#111827;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1350" height="42" as="geometry"/></mxCell>
        <mxCell id="m_subtitle" value="CachedDualStreamGazeWamTransformer | D=768, L=7, H=8, head_dim=96 | p_drop_emb=p_drop_attn=0.1 | use_block_attention_mask=True" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#4B5563;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="42" y="68" width="1510" height="28" as="geometry"/></mxCell>
        <mxCell id="m_badge" value="MODEL FORWARD" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#FFFFFF;fillColor=#374151;strokeColor=#374151;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1640" y="34" width="200" height="36" as="geometry"/></mxCell>
        <mxCell id="m_rgb" value="&lt;b&gt;camera0_rgb&lt;/b&gt;&lt;br&gt;[B,2,3,256,256]&lt;br&gt;ColorJitter + ImageNet Normalize" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=10;fillColor=#E8F1FB;strokeColor=#2F6FAE;fontColor=#163B5C;" vertex="1" parent="1"><mxGeometry x="40" y="145" width="210" height="105" as="geometry"/></mxCell>
        <mxCell id="m_dino" value="&lt;b&gt;TransformerObsEncoder&lt;/b&gt;&lt;br&gt;DINOv3 ViT-B/16, pretrained=True&lt;br&gt;frozen=False, aggregation=patch&lt;br&gt;移除 prefix token" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=10;fillColor=#E8F1FB;strokeColor=#2F6FAE;fontColor=#163B5C;" vertex="1" parent="1"><mxGeometry x="290" y="130" width="265" height="135" as="geometry"/></mxCell>
        <mxCell id="m_visual" value="&lt;b&gt;visual tokens&lt;/b&gt;&lt;br&gt;每帧 16x16=256 patches&lt;br&gt;2 帧 concat -&gt; [B,512,768]&lt;br&gt;use_frame_embedding=False" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=10;fillColor=#E8F1FB;strokeColor=#2F6FAE;fontColor=#163B5C;" vertex="1" parent="1"><mxGeometry x="595" y="130" width="250" height="135" as="geometry"/></mxCell>
        <mxCell id="m_gaze" value="&lt;b&gt;gaze_xy&lt;/b&gt;&lt;br&gt;[B,2], normalized [0,1]&lt;br&gt;has_gaze_label + use_gaze_condition" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=10;fillColor=#E9F7EF;strokeColor=#2D8A58;fontColor=#195D38;" vertex="1" parent="1"><mxGeometry x="40" y="315" width="210" height="105" as="geometry"/></mxCell>
        <mxCell id="m_gaze_enc" value="&lt;b&gt;GazeConditionEncoder&lt;/b&gt;&lt;br&gt;8x8 Gaussian basis, sigma=0.15&lt;br&gt;max normalize；Linear 64-&gt;768&lt;br&gt;trainable mask_token [1,1,768]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=10;fillColor=#E9F7EF;strokeColor=#2D8A58;fontColor=#195D38;" vertex="1" parent="1"><mxGeometry x="290" y="295" width="265" height="145" as="geometry"/></mxCell>
        <mxCell id="m_gaze_tok" value="&lt;b&gt;gaze / [MASK] token&lt;/b&gt;&lt;br&gt;torch.where(use_gaze, encoded, mask)&lt;br&gt;[B,1,768]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=10;fillColor=#E9F7EF;strokeColor=#2D8A58;fontColor=#195D38;" vertex="1" parent="1"><mxGeometry x="595" y="310" width="250" height="115" as="geometry"/></mxCell>
        <mxCell id="m_context" value="&lt;b&gt;Context assembly&lt;/b&gt;&lt;br&gt;concat visual + gaze = 513 tokens&lt;br&gt;+ modality embedding + learned position&lt;br&gt;image_proj/gaze_proj = Identity" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=10;fillColor=#F4F5F7;strokeColor=#4B5563;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="905" y="150" width="265" height="135" as="geometry"/></mxCell>
        <mxCell id="m_world" value="&lt;b&gt;ContextSelfBlock x7&lt;/b&gt;&lt;br&gt;LN -&gt; Q/K/V self-attention -&gt; residual&lt;br&gt;LN -&gt; MLP(768,3072,768) -&gt; residual&lt;br&gt;每层导出 K_l,V_l [B,8,513,96]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=12;fillColor=#F4F5F7;strokeColor=#374151;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="905" y="330" width="265" height="175" as="geometry"/></mxCell>
        <mxCell id="m_cache" value="&lt;b&gt;GazeWamWorldCache&lt;/b&gt;&lt;br&gt;7 组 per-layer K/V&lt;br&gt;&lt;b&gt;来源严格为 image + gaze/[MASK]&lt;/b&gt;&lt;br&gt;训练时供 action 与 heatmap 两支共享&lt;br&gt;推理时预填充一次并跨 DDIM step 复用" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=12;fillColor=#FFFFFF;strokeColor=#374151;fontColor=#111827;dashed=1;" vertex="1" parent="1"><mxGeometry x="905" y="555" width="265" height="175" as="geometry"/></mxCell>
        <mxCell id="m_action_in" value="&lt;b&gt;noisy_action&lt;/b&gt;&lt;br&gt;[B,16,10]&lt;br&gt;Linear 10-&gt;768 + t embedding&lt;br&gt;+ action position + modality" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=10;fillColor=#FFF1E8;strokeColor=#D76824;fontColor=#7A3514;" vertex="1" parent="1"><mxGeometry x="1240" y="130" width="245" height="135" as="geometry"/></mxCell>
        <mxCell id="m_action_dec" value="&lt;b&gt;Action TargetDecoderBlock x7&lt;/b&gt;&lt;br&gt;Q = 当前 action tokens（16）&lt;br&gt;K/V = concat(world K/V 513, action K/V 16)&lt;br&gt;mixed attention + residual + MLP&lt;br&gt;&lt;b&gt;不读取 noisy/target heatmap&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=12;fillColor=#FFF1E8;strokeColor=#D76824;fontColor=#7A3514;" vertex="1" parent="1"><mxGeometry x="1240" y="315" width="330" height="175" as="geometry"/></mxCell>
        <mxCell id="m_action_out" value="&lt;b&gt;action_ln_f + Linear 768-&gt;10&lt;/b&gt;&lt;br&gt;pred_action [B,16,10]&lt;br&gt;默认 prediction_type=epsilon" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=10;fillColor=#FFF1E8;strokeColor=#D76824;fontColor=#7A3514;" vertex="1" parent="1"><mxGeometry x="1615" y="335" width="235" height="135" as="geometry"/></mxCell>
        <mxCell id="m_heat_in" value="&lt;b&gt;noisy_heatmap latent&lt;/b&gt;&lt;br&gt;[B,256,16]&lt;br&gt;Linear 16-&gt;768 + t embedding&lt;br&gt;+ heatmap position + modality" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=10;fillColor=#F2ECFA;strokeColor=#7B4AB0;fontColor=#4C2675;" vertex="1" parent="1"><mxGeometry x="1240" y="585" width="245" height="135" as="geometry"/></mxCell>
        <mxCell id="m_heat_dec" value="&lt;b&gt;Heatmap TargetDecoderBlock x7&lt;/b&gt;&lt;br&gt;Q = 当前 heatmap tokens（256）&lt;br&gt;K/V = concat(world K/V 513, heatmap K/V 256)&lt;br&gt;mixed attention + residual + MLP&lt;br&gt;&lt;b&gt;不读取 action tokens&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=12;fillColor=#F2ECFA;strokeColor=#7B4AB0;fontColor=#4C2675;" vertex="1" parent="1"><mxGeometry x="1240" y="770" width="330" height="175" as="geometry"/></mxCell>
        <mxCell id="m_heat_out" value="&lt;b&gt;heatmap_ln_f + Linear 768-&gt;16&lt;/b&gt;&lt;br&gt;pred_heatmap [B,256,16]&lt;br&gt;主配置下先还原 clean latent，再解码监督" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=10;fillColor=#F2ECFA;strokeColor=#7B4AB0;fontColor=#4C2675;" vertex="1" parent="1"><mxGeometry x="1615" y="790" width="235" height="135" as="geometry"/></mxCell>
        <mxCell id="m_contract" value="&lt;b&gt;attention_contract_summary() 的精确解释&lt;/b&gt;&lt;br&gt;shared_world_kv_cache=True；world_cache_source=image_gaze_condition_prefill...&lt;br&gt;action_reads_heatmap_world_cache=True 是历史/兼容字段名，指共享 world-expert cache。&lt;br&gt;同一 summary 同时明确：action_reads_heatmap=False、action_reads_noisy_heatmap=False、action_reads_heatmap_target=False、heatmap_reads_action=False。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=12;fillColor=#FFF4D6;strokeColor=#C58A14;fontColor=#6B4A0B;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="805" height="190" as="geometry"/></mxCell>
        <mxCell id="m_counts" value="&lt;b&gt;代码报告的逻辑 token 计数&lt;/b&gt;&lt;br&gt;context = 512 + 1 = 513&lt;br&gt;train_sequence_tokens = 512 + 1 + 16 + 256 = 785&lt;br&gt;inference_sequence_tokens = 512 + 1 + 16 = 529&lt;br&gt;这些是 contract summary 计数；两条 target stream 实际分支执行，并未拼成互读序列。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=10;fillColor=#FFFFFF;strokeColor=#4B5563;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="805" height="150" as="geometry"/></mxCell>
        <mxCell id="m_note" value="关键代码：transformer_obs_encoder.py::{forward, aggregate_feature} | gaze_encoder.py::GazeConditionEncoder | cached_dual_stream_transformer.py::{prefill_world_cache, CachedMixedAttention, forward, attention_contract_summary}" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=11;fontColor=#4B5563;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="1015" width="1810" height="45" as="geometry"/></mxCell>
        <mxCell id="m_e1" edge="1" source="m_rgb" target="m_dino" parent="1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeColor=#2F6FAE;strokeWidth=2;endArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m_e2" edge="1" source="m_dino" target="m_visual" parent="1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeColor=#2F6FAE;strokeWidth=2;endArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m_e3" edge="1" source="m_gaze" target="m_gaze_enc" parent="1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeColor=#2D8A58;strokeWidth=2;endArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m_e4" edge="1" source="m_gaze_enc" target="m_gaze_tok" parent="1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeColor=#2D8A58;strokeWidth=2;endArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m_e5" edge="1" source="m_visual" target="m_context" parent="1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeColor=#2F6FAE;strokeWidth=2;endArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.25;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="875" y="197.5"/><mxPoint x="875" y="183.75"/></Array></mxGeometry></mxCell>
        <mxCell id="m_e6" edge="1" source="m_gaze_tok" target="m_context" parent="1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeColor=#2D8A58;strokeWidth=2;endArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.75;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="875" y="367.5"/><mxPoint x="875" y="251.25"/></Array></mxGeometry></mxCell>
        <mxCell id="m_e7" edge="1" source="m_context" target="m_world" parent="1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeColor=#374151;strokeWidth=2;endArrow=classic;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m_e8" value="7 x (K_l,V_l)" edge="1" source="m_world" target="m_cache" parent="1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeColor=#374151;strokeWidth=2;endArrow=classic;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m_e9" edge="1" source="m_action_in" target="m_action_dec" parent="1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeColor=#D76824;strokeWidth=2;endArrow=classic;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1362.5" y="290"/><mxPoint x="1405" y="290"/></Array></mxGeometry></mxCell>
        <mxCell id="m_e10" edge="1" source="m_cache" target="m_action_dec" parent="1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeColor=#374151;strokeWidth=1.7;endArrow=classic;dashed=1;exitX=1;exitY=0.25;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1215" y="598.75"/><mxPoint x="1215" y="402.5"/></Array></mxGeometry></mxCell>
        <mxCell id="m_e11" edge="1" source="m_action_dec" target="m_action_out" parent="1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeColor=#D76824;strokeWidth=2;endArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m_e12" edge="1" source="m_heat_in" target="m_heat_dec" parent="1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeColor=#7B4AB0;strokeWidth=2;endArrow=classic;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1362.5" y="745"/><mxPoint x="1405" y="745"/></Array></mxGeometry></mxCell>
        <mxCell id="m_e13" edge="1" source="m_cache" target="m_heat_dec" parent="1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeColor=#374151;strokeWidth=1.7;endArrow=classic;dashed=1;exitX=1;exitY=0.75;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1185" y="686.25"/><mxPoint x="1185" y="857.5"/></Array></mxGeometry></mxCell>
        <mxCell id="m_e14" edge="1" source="m_heat_dec" target="m_heat_out" parent="1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeColor=#7B4AB0;strokeWidth=2;endArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="gaze-wam-train-infer" name="03 训练与推理">
    <mxGraphModel dx="1900" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t_title" value="Gaze-WAM 主配置：训练、Action-only 推理与加载安全边界" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=28;fontStyle=1;fontColor=#111827;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1410" height="42" as="geometry"/></mxCell>
        <mxCell id="t_subtitle" value="DDIMScheduler: 50 train steps, epsilon prediction, squaredcos_cap_v2, clip_sample=True | inference=8 steps | cfg_scale=1.0" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#4B5563;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="42" y="68" width="1460" height="28" as="geometry"/></mxCell>
        <mxCell id="t_badge" value="TRAIN + INFERENCE" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#FFFFFF;fillColor=#374151;strokeColor=#374151;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1640" y="34" width="200" height="36" as="geometry"/></mxCell>
        <mxCell id="t_train_label" value="训练：一次 forward 同时计算 action 与 heatmap 分支" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontStyle=1;fontColor=#374151;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="112" width="900" height="30" as="geometry"/></mxCell>
        <mxCell id="t_gaze_target" value="&lt;b&gt;在线 heatmap target&lt;/b&gt;&lt;br&gt;target_gaze_mask = has_heatmap &amp; has_gaze_label&lt;br&gt;gaze_xy -&gt; 256x256 Gaussian（sigma=6 px）&lt;br&gt;若有 dense heatmap_image 则按 presence mask 覆盖" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=10;fillColor=#F2ECFA;strokeColor=#7B4AB0;fontColor=#4C2675;" vertex="1" parent="1"><mxGeometry x="40" y="155" width="295" height="145" as="geometry"/></mxCell>
        <mxCell id="t_cosmos_enc" value="&lt;b&gt;Frozen Cosmos encoder&lt;/b&gt;&lt;br&gt;max normalize -&gt; repeat RGB&lt;br&gt;range [0,1] -&gt; [-1,1]&lt;br&gt;@torch.no_grad(), 参数 requires_grad=False&lt;br&gt;[B,16,16,16] -&gt; [B,256,16]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=10;fillColor=#F2ECFA;strokeColor=#7B4AB0;fontColor=#4C2675;" vertex="1" parent="1"><mxGeometry x="380" y="145" width="275" height="165" as="geometry"/></mxCell>
        <mxCell id="t_latent" value="&lt;b&gt;Scheduler-space clean latent&lt;/b&gt;&lt;br&gt;normalized = (raw - 0.0) * 0.25&lt;br&gt;shape [B,256,16]&lt;br&gt;heatmap_noise ~ N(0,I)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=10;fillColor=#F2ECFA;strokeColor=#7B4AB0;fontColor=#4C2675;" vertex="1" parent="1"><mxGeometry x="700" y="160" width="260" height="135" as="geometry"/></mxCell>
        <mxCell id="t_action_target" value="&lt;b&gt;Normalized relative action&lt;/b&gt;&lt;br&gt;clean [B,16,10]&lt;br&gt;action_noise eps_a ~ N(0,I)&lt;br&gt;noisy input 使用 eps_a + 0.1 * extra_noise&lt;br&gt;&lt;b&gt;epsilon target 仍是原始 eps_a&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=10;fillColor=#FFF1E8;strokeColor=#D76824;fontColor=#7A3514;" vertex="1" parent="1"><mxGeometry x="40" y="355" width="295" height="155" as="geometry"/></mxCell>
        <mxCell id="t_timestep" value="&lt;b&gt;共享 timestep&lt;/b&gt;&lt;br&gt;t ~ Uniform{0,...,49}&lt;br&gt;action 与 heatmap 使用同一 t&lt;br&gt;scheduler.add_noise 分别生成两种 noisy target" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=10;fillColor=#FFF4D6;strokeColor=#C58A14;fontColor=#6B4A0B;" vertex="1" parent="1"><mxGeometry x="380" y="365" width="275" height="135" as="geometry"/></mxCell>
        <mxCell id="t_forward" value="&lt;b&gt;CachedDualStream forward&lt;/b&gt;&lt;br&gt;encode image + gaze/[MASK] -&gt; world cache&lt;br&gt;action decoder + heatmap decoder&lt;br&gt;mixed batch 中两支均执行&lt;br&gt;仅当 action_loss_mask 全空时可 skip_action" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=12;fillColor=#F4F5F7;strokeColor=#374151;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="700" y="350" width="260" height="165" as="geometry"/></mxCell>
        <mxCell id="t_action_loss" value="&lt;b&gt;Action loss&lt;/b&gt;&lt;br&gt;MSE(pred_action, eps_a)&lt;br&gt;逐样本 mean 后 masked mean&lt;br&gt;mask=(~is_open) &amp; has_action&lt;br&gt;weight=1.0" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=10;fillColor=#FFF1E8;strokeColor=#D76824;fontColor=#7A3514;" vertex="1" parent="1"><mxGeometry x="1010" y="170" width="250" height="135" as="geometry"/></mxCell>
        <mxCell id="t_clean_heat" value="&lt;b&gt;Pred clean heatmap latent&lt;/b&gt;&lt;br&gt;pred epsilon + noisy sample + t -&gt; x0&lt;br&gt;raw = normalized / 0.25 + 0.0&lt;br&gt;Frozen Cosmos decoder -&gt; [B,256,256]&lt;br&gt;decoder 参数冻结，但保留对输入 latent 的梯度" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=10;fillColor=#F2ECFA;strokeColor=#7B4AB0;fontColor=#4C2675;" vertex="1" parent="1"><mxGeometry x="1010" y="350" width="300" height="165" as="geometry"/></mxCell>
        <mxCell id="t_heat_loss" value="&lt;b&gt;Heatmap loss = dsnt_js&lt;/b&gt;&lt;br&gt;DSNT XY(pred image, gaze_xy) * 1.0&lt;br&gt;+ spatial JS(pred image, Gaussian target) * 1.0&lt;br&gt;temperature=0.1, mode=intensity_softplus&lt;br&gt;mask=has_heatmap &amp; has_gaze_label&lt;br&gt;latent MSE=False；token KL weight=0；final aux=False" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=12;fillColor=#F2ECFA;strokeColor=#7B4AB0;fontColor=#4C2675;" vertex="1" parent="1"><mxGeometry x="1360" y="330" width="420" height="205" as="geometry"/></mxCell>
        <mxCell id="t_total" value="&lt;b&gt;Total loss&lt;/b&gt;&lt;br&gt;1.0 * action_loss + 1.0 * heatmap_loss&lt;br&gt;+ 0.0 * heatmap_token_kl + 0 final auxiliary" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;fontFamily=Arial;fontSize=13;align=center;verticalAlign=middle;spacing=10;fillColor=#FFFFFF;strokeColor=#374151;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="1360" y="160" width="420" height="120" as="geometry"/></mxCell>
        <mxCell id="t_infer_label" value="正式 action 推理：heatmap stream 完全省略" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontStyle=1;fontColor=#374151;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="595" width="900" height="30" as="geometry"/></mxCell>
        <mxCell id="t_obs" value="&lt;b&gt;Observation + optional gaze&lt;/b&gt;&lt;br&gt;normalizer.normalize(obs)&lt;br&gt;512 visual tokens + gaze 或 learned [MASK]&lt;br&gt;gaze 缺失时自动 use_gaze=False" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=10;fillColor=#E8F1FB;strokeColor=#2F6FAE;fontColor=#163B5C;" vertex="1" parent="1"><mxGeometry x="40" y="645" width="280" height="140" as="geometry"/></mxCell>
        <mxCell id="t_prefill" value="&lt;b&gt;prefill_world_cache 一次&lt;/b&gt;&lt;br&gt;image + gaze/[MASK] 通过 7 个 context blocks&lt;br&gt;保存 7 组 K_l,V_l&lt;br&gt;默认 CFG=1.0：不生成第二个 masked cache" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=12;fillColor=#F4F5F7;strokeColor=#374151;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="370" y="640" width="305" height="150" as="geometry"/></mxCell>
        <mxCell id="t_ddim" value="&lt;b&gt;8-step DDIM action denoising&lt;/b&gt;&lt;br&gt;x_T ~ N(0,I), [B,16,10]&lt;br&gt;每步只运行 action decoder&lt;br&gt;noisy_heatmap=None, is_inference=True&lt;br&gt;复用同一 world cache；heatmap output=None" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=12;fillColor=#FFF1E8;strokeColor=#D76824;fontColor=#7A3514;" vertex="1" parent="1"><mxGeometry x="730" y="630" width="320" height="170" as="geometry"/></mxCell>
        <mxCell id="t_cfg" value="&lt;b&gt;仅 cfg_scale != 1 时&lt;/b&gt;&lt;br&gt;额外 prefill image+[MASK] cache&lt;br&gt;masked + scale * (conditioned - masked)&lt;br&gt;默认 scale=1.0，此分支不执行" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.3;fontFamily=Arial;fontSize=12;align=left;verticalAlign=middle;spacing=9;fillColor=#E9F7EF;strokeColor=#2D8A58;fontColor=#195D38;dashed=1;" vertex="1" parent="1"><mxGeometry x="730" y="840" width="320" height="125" as="geometry"/></mxCell>
        <mxCell id="t_config_security" value="&lt;b&gt;配置执行边界&lt;/b&gt;&lt;br&gt;${eval:...} -&gt; safe_arithmetic_eval&lt;br&gt;仅数值常量与 + - * / // %、一元 +/-&lt;br&gt;拒绝 Call / Name / Attribute / 非有限或超限结果" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;fontFamily=Arial;fontSize=12;align=left;verticalAlign=middle;spacing=9;fillColor=#FDECEC;strokeColor=#B94A48;fontColor=#7A2523;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="280" height="125" as="geometry"/></mxCell>
        <mxCell id="t_checkpoint_security" value="&lt;b&gt;Checkpoint 信任边界&lt;/b&gt;&lt;br&gt;公开 API 默认拒绝 dill/pickle&lt;br&gt;--trust-checkpoint / trust_checkpoint=True + regular file&lt;br&gt;通过后才 torch.load(dill) 与 workspace/policy 重建&lt;br&gt;rank 间 normalizer：state_dict + weights_only=True" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;fontFamily=Arial;fontSize=12;align=left;verticalAlign=middle;spacing=9;fillColor=#FDECEC;strokeColor=#B94A48;fontColor=#7A2523;" vertex="1" parent="1"><mxGeometry x="370" y="840" width="305" height="125" as="geometry"/></mxCell>
        <mxCell id="t_output" value="&lt;b&gt;Action output&lt;/b&gt;&lt;br&gt;unnormalize -&gt; relative [B,16,10]&lt;br&gt;若提供 action_base_abs：base @ relative -&gt; absolute TCP&lt;br&gt;gripper 仍为绝对标量；result['action'] 改为 absolute" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=10;fillColor=#FFF1E8;strokeColor=#D76824;fontColor=#7A3514;" vertex="1" parent="1"><mxGeometry x="1110" y="640" width="340" height="150" as="geometry"/></mxCell>
        <mxCell id="t_diag" value="&lt;b&gt;独立 heatmap diagnostic path&lt;/b&gt;&lt;br&gt;predict_heatmap / conditional_heatmap_sample&lt;br&gt;默认使用 [MASK] 避免复制 gaze label&lt;br&gt;迭代路径复用 world cache 并 skip_action=True&lt;br&gt;仅用于预览/评估，不进入正式 robot action inference" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=10;fillColor=#F2ECFA;strokeColor=#7B4AB0;fontColor=#4C2675;dashed=1;" vertex="1" parent="1"><mxGeometry x="1510" y="630" width="310" height="170" as="geometry"/></mxCell>
        <mxCell id="t_note" value="关键代码：gaze_wam_policy.py::{compute_loss_components, conditional_sample, predict_action, conditional_heatmap_sample, predict_heatmap} | heatmap_decoder.py::CosmosHeatmapCodec | cached_dual_stream_transformer.py::forward | omegaconf_resolvers.py | checkpoint_security.py | base_workspace.py" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=11;fontColor=#4B5563;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="1015" width="1780" height="45" as="geometry"/></mxCell>
        <mxCell id="t_e1" edge="1" source="t_gaze_target" target="t_cosmos_enc" parent="1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeColor=#7B4AB0;strokeWidth=2;endArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t_e2" edge="1" source="t_cosmos_enc" target="t_latent" parent="1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeColor=#7B4AB0;strokeWidth=2;endArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t_e3" edge="1" source="t_latent" target="t_forward" parent="1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeColor=#7B4AB0;strokeWidth=2;endArrow=classic;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t_e4" edge="1" source="t_action_target" target="t_forward" parent="1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeColor=#D76824;strokeWidth=2;endArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="355" y="432.5"/><mxPoint x="355" y="330"/><mxPoint x="680" y="330"/><mxPoint x="680" y="383"/></Array></mxGeometry></mxCell>
        <mxCell id="t_e5" value="shared t" edge="1" source="t_timestep" target="t_forward" parent="1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeColor=#C58A14;strokeWidth=1.7;endArrow=classic;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.82;labelPosition=center;verticalLabelPosition=bottom;spacingBottom=6;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="670" y="432.5"/><mxPoint x="670" y="540"/><mxPoint x="690" y="540"/><mxPoint x="690" y="485.3"/></Array></mxGeometry></mxCell>
        <mxCell id="t_e6" edge="1" source="t_forward" target="t_action_loss" parent="1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeColor=#D76824;strokeWidth=2;endArrow=classic;exitX=1;exitY=0.25;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="970" y="391.25"/><mxPoint x="970" y="237.5"/></Array></mxGeometry></mxCell>
        <mxCell id="t_e7" edge="1" source="t_forward" target="t_clean_heat" parent="1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeColor=#7B4AB0;strokeWidth=2;endArrow=classic;exitX=1;exitY=0.75;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="995" y="473.75"/><mxPoint x="995" y="432.5"/></Array></mxGeometry></mxCell>
        <mxCell id="t_e8" edge="1" source="t_clean_heat" target="t_heat_loss" parent="1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeColor=#7B4AB0;strokeWidth=2;endArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t_e9" edge="1" source="t_action_loss" target="t_total" parent="1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeColor=#D76824;strokeWidth=2;endArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.6458333333;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t_e10" edge="1" source="t_heat_loss" target="t_total" parent="1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeColor=#7B4AB0;strokeWidth=2;endArrow=classic;exitX=0.95;exitY=0;entryX=0.95;entryY=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t_e11" edge="1" source="t_obs" target="t_prefill" parent="1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeColor=#2F6FAE;strokeWidth=2;endArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t_e12" edge="1" source="t_prefill" target="t_ddim" parent="1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeColor=#374151;strokeWidth=2;endArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t_e13" value="optional" edge="1" source="t_cfg" target="t_ddim" parent="1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeColor=#2D8A58;strokeWidth=1.5;endArrow=classic;dashed=1;fontSize=11;exitX=0.5;exitY=0;entryX=0.5;entryY=1;labelPosition=left;verticalLabelPosition=middle;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t_e14" edge="1" source="t_ddim" target="t_output" parent="1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeColor=#D76824;strokeWidth=2;endArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t_e15" value="separate" edge="1" source="t_obs" target="t_diag" parent="1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeColor=#7B4AB0;strokeWidth=1.5;endArrow=classic;dashed=1;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;labelPosition=center;verticalLabelPosition=bottom;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="340" y="715"/><mxPoint x="340" y="820"/><mxPoint x="1480" y="820"/><mxPoint x="1480" y="715"/></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="gaze-wam-training-schedule" name="04 Training schedule and experiment contract">
    <mxGraphModel dx="1900" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="s_title" value="Gaze-WAM training schedule (code-aligned)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=28;fontStyle=1;fontColor=#111827;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1400" height="42" as="geometry"/></mxCell>
        <mxCell id="s_subtitle" value="Planner/default comparison: robot-only baseline + fixed-quota mixed main -&gt; robot validation gate -&gt; real evaluation | open-only pretraining is an explicit optional ablation" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#4B5563;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="42" y="68" width="1680" height="28" as="geometry"/></mxCell>
        <mxCell id="s_stage" value="&lt;b&gt;Stage selector: training.stage&lt;/b&gt;&lt;br&gt;main: mixed_train (default comparison arm)&lt;br&gt;baseline: robot_only (paired baseline)&lt;br&gt;optional: open_pretrain -&gt; robot_finetune&lt;br&gt;open_only remains explicit legacy/ablation; never implicit" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=12;fillColor=#FFFFFF;strokeColor=#374151;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="300" height="165" as="geometry"/></mxCell>
        <mxCell id="s_robot" value="&lt;b&gt;Robot-only baseline&lt;/b&gt;&lt;br&gt;config: train_gaze_wam_robot_only_workspace&lt;br&gt;paired comparison arm; robot_ratio=1.0, open_ratio=0.0&lt;br&gt;robot dataloader is the epoch driver&lt;br&gt;checkpoint monitor: val_robot_loss" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=12;fillColor=#E8F1FB;strokeColor=#2F6FAE;fontColor=#163B5C;" vertex="1" parent="1"><mxGeometry x="390" y="130" width="320" height="165" as="geometry"/></mxCell>
        <mxCell id="s_mixed" value="&lt;b&gt;Mixed training (main)&lt;/b&gt;&lt;br&gt;stage=mixed_train; two Zarr sources remain separate&lt;br&gt;data_mixing.total_batch_size_per_process + ratios resolve integer quotas&lt;br&gt;current default: 64/process = 48 robot + 16 open (75/25)&lt;br&gt;open iterator restarts when exhausted; robot remains the epoch clock" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=12;fillColor=#E9F7EF;strokeColor=#2D8A58;fontColor=#195D38;" vertex="1" parent="1"><mxGeometry x="760" y="115" width="390" height="195" as="geometry"/></mxCell>
        <mxCell id="s_gate" value="&lt;b&gt;Robot validation gate&lt;/b&gt;&lt;br&gt;val_robot_loss is the primary selection metric for robot-enabled stages&lt;br&gt;Top-K checkpoint monitor_key=val_robot_loss&lt;br&gt;robot action and active robot heatmap terms are logged separately&lt;br&gt;open validation remains diagnostic only" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=12;fillColor=#FFF4D6;strokeColor=#C58A14;fontColor=#6B4A0B;" vertex="1" parent="1"><mxGeometry x="1210" y="130" width="350" height="165" as="geometry"/></mxCell>
        <mxCell id="s_real" value="&lt;b&gt;Real evaluation&lt;/b&gt;&lt;br&gt;robot action quality&lt;br&gt;gaze quality&lt;br&gt;latency / success" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=12;fillColor=#FDECEC;strokeColor=#B94A48;fontColor=#7A2523;" vertex="1" parent="1"><mxGeometry x="1630" y="150" width="220" height="125" as="geometry"/></mxCell>
        <mxCell id="s_dino" value="&lt;b&gt;DINOv3 initialization&lt;/b&gt;&lt;br&gt;policy.obs_encoder.pretrained=true&lt;br&gt;standard visual-weight initialization&lt;br&gt;distinct from task-level open pretraining" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=10;fillColor=#E8F1FB;strokeColor=#2F6FAE;fontColor=#163B5C;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="300" height="135" as="geometry"/></mxCell>
        <mxCell id="s_pretrain" value="&lt;b&gt;Optional open pretraining&lt;/b&gt;&lt;br&gt;stage=open_pretrain; robot quota=0&lt;br&gt;open rows: has_action=false; action loss is masked&lt;br&gt;supervises gaze/heatmap representation, not robot action mapping&lt;br&gt;requires explicit global max_train_steps and transfer.export_path&lt;br&gt;current optional config: 5000 optimizer steps" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=12;fillColor=#F2ECFA;strokeColor=#7B4AB0;fontColor=#4C2675;dashed=1;" vertex="1" parent="1"><mxGeometry x="390" y="370" width="320" height="175" as="geometry"/></mxCell>
        <mxCell id="s_artifact" value="&lt;b&gt;Fixed-step transfer artifact&lt;/b&gt;&lt;br&gt;export_gaze_wam_transfer_artifact&lt;br&gt;scope: obs_encoder or obs_and_gaze&lt;br&gt;weights_only load; strict key/shape/finite checks&lt;br&gt;artifact is the only hand-off to robot fine-tuning" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=12;fillColor=#FFFFFF;strokeColor=#7B4AB0;fontColor=#4C2675;dashed=1;" vertex="1" parent="1"><mxGeometry x="760" y="390" width="390" height="145" as="geometry"/></mxCell>
        <mxCell id="s_finetune" value="&lt;b&gt;Robot fine-tune&lt;/b&gt;&lt;br&gt;config: train_gaze_wam_robot_finetune_workspace&lt;br&gt;stage=robot_finetune; positive robot quota, open=0&lt;br&gt;training.transfer.load_path is required&lt;br&gt;robot normalizer and action supervision are restored&lt;br&gt;checkpoint resume and transfer load cannot be combined" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=12;fillColor=#FFF1E8;strokeColor=#D76824;fontColor=#7A3514;dashed=1;" vertex="1" parent="1"><mxGeometry x="1210" y="385" width="350" height="155" as="geometry"/></mxCell>
        <mxCell id="s_contract_band" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F9FAFB;strokeColor=#D1D5DB;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="30" y="625" width="1830" height="255" as="geometry"/></mxCell>
        <mxCell id="s_contract_title" value="Runtime contracts (supporting details; not additional training stages)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontStyle=1;fontColor=#374151;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="50" y="640" width="900" height="28" as="geometry"/></mxCell>
        <mxCell id="s_quota" value="&lt;b&gt;Quota contract&lt;/b&gt;&lt;br&gt;data_mixing.total_batch_size_per_process&lt;br&gt;robot_ratio + open_ratio = 1.0&lt;br&gt;ratios round to integer source quotas; total is preserved&lt;br&gt;robot_tail_policy / open_tail_policy: keep, drop, or pad" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=10;fillColor=#FFFFFF;strokeColor=#374151;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="400" height="175" as="geometry"/></mxCell>
        <mxCell id="s_stream" value="&lt;b&gt;Online source streaming&lt;/b&gt;&lt;br&gt;build_gaze_wam_dataloader&lt;br&gt;robot: one pass defines an epoch&lt;br&gt;open: RestartingDataLoaderIterator on exhaustion&lt;br&gt;FixedSizeBatchCollator repeats only tail samples under pad&lt;br&gt;no offline merged Zarr" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=10;fillColor=#FFFFFF;strokeColor=#374151;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="480" y="680" width="400" height="175" as="geometry"/></mxCell>
        <mxCell id="s_steps" value="&lt;b&gt;Global optimizer-step budget&lt;/b&gt;&lt;br&gt;training.max_train_steps is global, not per epoch&lt;br&gt;gradient accumulation flushes at epoch boundary&lt;br&gt;Accelerate sync_with_dataloader=true is required&lt;br&gt;scheduler plan uses prepared per-rank dataloader length&lt;br&gt;runtime asserts planned length == len(prepared epoch driver)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=10;fillColor=#FFFFFF;strokeColor=#374151;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="920" y="680" width="390" height="175" as="geometry"/></mxCell>
        <mxCell id="s_validation" value="&lt;b&gt;Metrics and acceptance&lt;/b&gt;&lt;br&gt;val_robot_loss = robot action + active robot heatmap components&lt;br&gt;val_open_heatmap_loss is diagnostic only in mixed runs&lt;br&gt;compare ratios at matched global steps and matched robot sample exposure&lt;br&gt;accept transfer only when robot validation and real evaluation improve" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=10;fillColor=#FFFFFF;strokeColor=#374151;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="1350" y="680" width="500" height="175" as="geometry"/></mxCell>
        <mxCell id="s_note" value="Legend: thick solid = default experiment path | dashed = optional ablation/initialization | gray band = supporting runtime contracts, intentionally unconnected to avoid false stage semantics" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#4B5563;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="965" width="1800" height="36" as="geometry"/></mxCell>
        <mxCell id="s_e1" edge="1" source="s_stage" target="s_robot" parent="1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeColor=#2F6FAE;strokeWidth=3;endArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s_e2" value="independent comparison" edge="1" source="s_robot" target="s_mixed" parent="1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeColor=#2D8A58;strokeWidth=3;endArrow=classic;fontSize=11;fontColor=#195D38;exitX=1;exitY=0.5;entryX=0;entryY=0.5;labelPosition=center;verticalLabelPosition=top;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s_e3" edge="1" source="s_mixed" target="s_gate" parent="1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeColor=#C58A14;strokeWidth=3;endArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s_e4" edge="1" source="s_gate" target="s_real" parent="1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeColor=#B94A48;strokeWidth=3;endArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s_e5" value="optional ablation" edge="1" source="s_stage" target="s_pretrain" parent="1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeColor=#7B4AB0;strokeWidth=2;endArrow=classic;dashed=1;fontSize=11;fontColor=#4C2675;exitX=1;exitY=1;entryX=0.5;entryY=0;labelPosition=left;verticalLabelPosition=middle;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="350" y="295"/><mxPoint x="350" y="330"/><mxPoint x="550" y="330"/></Array></mxGeometry></mxCell>
